    <div data-template-id="duration-selector" id="duration-selector" class="canva-section mb-8 grid grid-cols-3 sm:grid-cols-6 gap-2 sm:gap-3 opacity-100 transition-opacity duration-500" style="background: none;"><button class="duration-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-sm sm:text-base" data-minutes="5">5m</button> <button class="duration-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-sm sm:text-base" data-minutes="10">10m</button> <button class="duration-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-sm sm:text-base" data-minutes="15">15m</button> <button class="duration-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-sm sm:text-base" data-minutes="20">20m</button> <button class="duration-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-sm sm:text-base" data-minutes="30">30m</button> <button class="duration-btn px-3 sm:px-4 py-2 rounded-lg font-semibold text-sm sm:text-base" data-minutes="45">45m</button>
    </div><!-- Control buttons -->
    <div class="flex gap-4 z-10 relative">
     <button id="start-btn" data-template-id="start-button" class="canva-button btn-primary px-8 py-3 rounded-full font-semibold transition-all" style="background: rgb(255, 255, 255); color: rgb(55, 46, 24); font-weight: 600; font-size: 16px;">Start</button> <button id="reset-btn" data-template-id="reset-button" class="canva-button btn-secondary px-8 py-3 rounded-full font-semibold transition-all" style="background: rgba(255, 255, 255, 0.2); color: rgb(255, 255, 255); font-weight: 600; font-size: 16px;">Reset</button>
